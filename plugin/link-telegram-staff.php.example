.tg-meta-value a { color: #2563eb; text-decoration: none; }
.tg-meta-value a:hover { text-decoration: underline; }
.tg-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
.tg-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 8px; border: none; cursor: pointer; font-weight: 600; font-size: 0.95em; text-decoration: none !important; transition: transform 0.05s, box-shadow 0.15s, background 0.15s; font-family: inherit; }
.tg-btn:hover { box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
.tg-btn:active { transform: translateY(1px); }
.tg-btn-primary { background: #2563eb; color: #fff !important; }
.tg-btn-primary:hover { background: #1d4ed8; color: #fff !important; }
.tg-btn-danger { background: transparent; color: #dc2626 !important; border: 1px solid rgba(220, 38, 38, 0.4); }
.tg-btn-danger:hover { background: rgba(220, 38, 38, 0.08); }
