            <div class="tg-steps">
                <div class="tg-step">
                    <span class="tg-step-num">1</span>
                    <div class="tg-step-icon">👇</div>
                    <div class="tg-step-text">Presiona <strong>Vincular mi Telegram</strong>.</div>
