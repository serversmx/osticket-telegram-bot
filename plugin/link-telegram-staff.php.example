                </div>
                <label for="btn_view_ticket_label">Etiqueta</label>
                <div><input type="text" id="btn_view_ticket_label" name="btn_view_ticket_label" value="<?php echo Format::htmlchars($g('btn_view_ticket_label', 'View ticket')); ?>" placeholder="View ticket"></div>

                <label for="btn_reply">Botón "Responder"</label>
                <div>
                    <input type="checkbox" id="btn_reply" name="btn_reply" value="1" <?php echo $on('btn_reply') ? 'checked' : ''; ?>>
