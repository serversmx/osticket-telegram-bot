<?php
/**
 * Staff-facing Telegram link management page.
 *
 * Drop this file in osTicket's `scp/` directory:
 *
 *   cp plugin/link-telegram-staff.php.example /path/to/osticket/scp/link-telegram.php
 *
 * Renders inside the standard osTicket staff header / footer. Two views:
 *
 *   - Not yet linked:  step-by-step "how it works" + big "Vincular" CTA
 *   - Already linked:  status card with bot info + Unlink button
 *
 * NOTE: never use `$cfg` as a local — staff.inc.php sets it as the global
 * OsticketConfig and header.inc.php calls $cfg->getAllowIframes(). Shadowing
 * crashes the page. We use $pluginCfg for the plugin's config.
 *
 * @license GPL-2.0-or-later
 */

require_once 'staff.inc.php';

if (!$thisstaff || !$thisstaff->getId() || !$thisstaff->isValid()) {
    Http::redirect('login.php');
    exit;
}

// Locate the plugin + side-load the active instance config.
$plugin = null;
try {
    $pm = new PluginManager();
    foreach ($pm->allInstalled() as $p) {
        if (method_exists($p, 'getName')
                && stripos($p->getName(), 'Telegram Bot Notifications') !== false) {
            $plugin = $p;
            if (method_exists($p, 'getActiveInstances')) {
                foreach ($p->getActiveInstances() as $inst) {
                    $p->getConfig($inst);
                    break;
                }
            }
            break;
        }
    }
} catch (Exception $e) {
    error_log('[TelegramBot/link-staff] plugin lookup failed: ' . $e->getMessage());
}

if (!$plugin) {
    require_once STAFFINC_DIR . 'header.inc.php';
    echo '<div class="error" style="padding:20px;">Telegram plugin not available right now.</div>';
    require_once STAFFINC_DIR . 'footer.inc.php';
    exit;
}

$staffId = (int) $thisstaff->getId();
$action  = isset($_POST['action']) ? $_POST['action'] : (isset($_GET['action']) ? $_GET['action'] : '');

// ─── Action: start linking ────────────────────────────────────────────
if ($action === 'link' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $url = $plugin->generateStaffLinkUrl($staffId);
    } catch (Exception $e) {
        error_log('[TelegramBot/link-staff] generateStaffLinkUrl failed: ' . $e->getMessage());
        $url = null;
    }
    if ($url && preg_match('#^https://t\.me/#', $url)) {
        Http::redirect($url);
        exit;
    }
    $errorMsg = 'No se pudo generar la URL de vinculación. Intenta de nuevo.';
}

// ─── Action: unlink ───────────────────────────────────────────────────
if ($action === 'unlink' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $rm = new ReflectionMethod($plugin, 'links');
        $rm->setAccessible(true);
        $store = $rm->invoke($plugin);
        $store->unlinkStaffById($staffId);
        $okMsg = 'Telegram desvinculado. Ya no recibirás notificaciones aquí.';
    } catch (Exception $e) {
        error_log('[TelegramBot/link-staff] unlink failed: ' . $e->getMessage());
        $errorMsg = 'No se pudo desvincular. Intenta de nuevo.';
    }
}

// ─── Read current link status ────────────────────────────────────────
$linkedChatId = null;
$linkedAt = null;
try {
    $rm = new ReflectionMethod($plugin, 'links');
    $rm->setAccessible(true);
    $store = $rm->invoke($plugin);
    $linkedChatId = $store->chatIdForStaff($staffId);
    // Read linked_at directly to show "linked since"
    if ($linkedChatId !== null) {
        $res = db_query('SELECT linked_at FROM ' . TABLE_PREFIX . 'telegram_staff_links WHERE staff_id=' . $staffId);
        if ($res && ($row = db_fetch_array($res))) {
            $linkedAt = (int) $row['linked_at'];
        }
    }
} catch (Exception $e) {
    error_log('[TelegramBot/link-staff] lookup failed: ' . $e->getMessage());
}

// IMPORTANT: never use `$cfg` as a local — it's the OsticketConfig global.
$botUsername = '';
try {
    $pluginCfg = $plugin->getConfig();
    $botUsername = $pluginCfg ? (string) $pluginCfg->get('bot_username') : '';
} catch (Exception $e) {}

if ($nav) {
    $nav->setTabActive('dashboard');
}
require_once STAFFINC_DIR . 'header.inc.php';

// Mask the chat_id for display: keep first 2 + last 4 digits.
$maskChat = function ($id) {
    $s = (string) $id;
    $len = strlen($s);
    if ($len <= 6) { return str_repeat('•', $len); }
    return substr($s, 0, 2) . str_repeat('•', $len - 6) . substr($s, -4);
};
?>

<style>
/* Theme-agnostic CSS: semi-transparent backgrounds + `color: inherit` so the */
/* page looks right against any theme (light, dark, custom branded). All */
/* selectors prefixed with .tg-page to avoid clashing with osTicket. */
/* Explicit system font stack — `inherit` was falling back to browser default */
/* serif when osTicket didn't set font-family on the parent container. */
.tg-page {
    width: 100%;
    color: inherit;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.5;
}
.tg-page h2.tg-title { font-size: 1.5em; margin: 0 0 6px; font-weight: 600; color: inherit; }
.tg-page .tg-subtitle { opacity: 0.7; margin: 0 0 24px; font-size: 0.95em; }
.tg-card {
    background: rgba(127, 127, 127, 0.06);
    border: 1px solid rgba(127, 127, 127, 0.2);
    border-radius: 12px;
    padding: 22px; margin-bottom: 18px;
}
.tg-card-linked { border-left: 4px solid #16a34a; }
.tg-card-unlinked { border-left: 4px solid #2563eb; }
.tg-status-row { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
.tg-status-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 999px;
    font-weight: 600; font-size: 0.85em;
}
.tg-status-linked { background: rgba(22, 163, 74, 0.15); color: #16a34a; }
.tg-status-unlinked { background: rgba(37, 99, 235, 0.15); color: #2563eb; }
.tg-meta-row {
    display: flex; flex-wrap: wrap; gap: 10px 28px;
    padding: 14px 16px;
    background: rgba(127, 127, 127, 0.08);
    border-radius: 8px; margin: 14px 0;
}
.tg-meta-item { display: flex; flex-direction: column; min-width: 140px; }
.tg-meta-label { opacity: 0.6; font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 2px; }
.tg-meta-value { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.95em; color: inherit; }
.tg-meta-value a { color: #2563eb; text-decoration: none; }
.tg-meta-value a:hover { text-decoration: underline; }
.tg-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
.tg-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 8px; border: none;
    cursor: pointer; font-weight: 600; font-size: 0.95em;
    text-decoration: none !important;
    transition: transform 0.05s, box-shadow 0.15s, background 0.15s;
}
.tg-btn:hover { box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
.tg-btn:active { transform: translateY(1px); }
.tg-btn-primary { background: #2563eb; color: #fff !important; }
.tg-btn-primary:hover { background: #1d4ed8; color: #fff !important; }
.tg-btn-danger {
    background: transparent; color: #dc2626 !important;
    border: 1px solid rgba(220, 38, 38, 0.4);
}
.tg-btn-danger:hover { background: rgba(220, 38, 38, 0.08); }
.tg-btn-large { padding: 14px 26px; font-size: 1.05em; }
.tg-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 18px 0; }
.tg-step {
    background: rgba(127, 127, 127, 0.06);
    border: 1px solid rgba(127, 127, 127, 0.2);
    border-radius: 10px;
    padding: 16px 12px 12px; text-align: center; position: relative;
}
.tg-step-num {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    background: #2563eb; color: #fff;
    width: 26px; height: 26px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 0.85em;
}
.tg-step-icon { font-size: 1.6em; margin: 8px 0 6px; }
.tg-step-text { opacity: 0.8; font-size: 0.88em; line-height: 1.4; color: inherit; }
.tg-info-list { margin: 14px 0 0 0; padding: 0; list-style: none; }
.tg-info-list li { padding: 6px 0; opacity: 0.85; display: flex; align-items: start; gap: 10px; }
.tg-info-list li:before { content: "✓"; color: #16a34a; font-weight: 700; flex-shrink: 0; }
.tg-flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 0.95em; }
.tg-flash-ok { background: rgba(22, 163, 74, 0.15); color: #16a34a; border: 1px solid rgba(22, 163, 74, 0.3); }
.tg-flash-err { background: rgba(220, 38, 38, 0.12); color: #dc2626; border: 1px solid rgba(220, 38, 38, 0.3); }
.tg-divider { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(127, 127, 127, 0.2); opacity: 0.7; font-size: 0.88em; }
@media (max-width: 640px) {
    .tg-steps { grid-template-columns: 1fr; }
}
</style>

<div class="tg-page">
    <h2 class="tg-title">📲 Notificaciones por Telegram</h2>
    <p class="tg-subtitle">Recibe alertas de tickets directamente en tu Telegram. Sin contraseñas, sin chat IDs — un clic y listo.</p>

    <?php if (!empty($okMsg)): ?>
        <div class="tg-flash tg-flash-ok"><?php echo Format::htmlchars($okMsg); ?></div>
    <?php endif; ?>
    <?php if (!empty($errorMsg)): ?>
        <div class="tg-flash tg-flash-err"><?php echo Format::htmlchars($errorMsg); ?></div>
    <?php endif; ?>

    <?php if ($linkedChatId): ?>
        <div class="tg-card tg-card-linked">
            <div class="tg-status-row">
                <div style="font-size: 2.2em; line-height: 1;">✅</div>
                <div style="flex: 1; min-width: 200px;">
                    <div style="font-size: 1.15em; font-weight: 600;">
                        Cuenta vinculada
                    </div>
                    <div style="opacity: 0.7; font-size: 0.92em; margin-top: 2px;">
                        Estás recibiendo notificaciones admin en este chat.
                    </div>
                </div>
                <span class="tg-status-badge tg-status-linked">● ACTIVO</span>
            </div>

            <div class="tg-meta-row">
                <div class="tg-meta-item">
                    <span class="tg-meta-label">Chat ID</span>
                    <span class="tg-meta-value"><?php echo Format::htmlchars($maskChat($linkedChatId)); ?></span>
                </div>
                <div class="tg-meta-item">
                    <span class="tg-meta-label">Bot</span>
                    <span class="tg-meta-value">
                        <?php if ($botUsername): ?>
                            <a href="https://t.me/<?php echo rawurlencode($botUsername); ?>" target="_blank" rel="noopener">@<?php echo Format::htmlchars($botUsername); ?></a>
                        <?php else: ?>
                            <em style="color:#94a3b8;">no configurado</em>
                        <?php endif; ?>
                    </span>
                </div>
                <?php if ($linkedAt): ?>
                <div class="tg-meta-item">
                    <span class="tg-meta-label">Vinculado desde</span>
                    <span class="tg-meta-value"><?php echo Format::htmlchars(date('Y-m-d H:i', $linkedAt)); ?></span>
                </div>
                <?php endif; ?>
            </div>

            <div class="tg-actions">
                <?php if ($botUsername): ?>
                    <a href="https://t.me/<?php echo rawurlencode($botUsername); ?>" target="_blank" rel="noopener" class="tg-btn tg-btn-primary">
                        💬 Abrir chat con el bot
                    </a>
                <?php endif; ?>
                <form method="POST" style="display: inline;" onsubmit="return confirm('¿Seguro que quieres desvincular? Dejarás de recibir notificaciones aquí.');">
                    <?php csrf_token(); ?>
                    <input type="hidden" name="action" value="unlink">
                    <button class="tg-btn tg-btn-danger" type="submit">🔌 Desvincular</button>
                </form>
            </div>
        </div>

        <div class="tg-card">
            <div style="font-weight: 600; margin-bottom: 12px;">Qué recibes en tu Telegram</div>
            <ul class="tg-info-list">
                <li>Nuevos tickets creados por clientes</li>
                <li>Respuestas de clientes en tickets existentes</li>
                <li>Cambios de estado del ticket (si están activados en la config)</li>
                <li>Reasignaciones de ticket (si están activadas en la config)</li>
            </ul>
        </div>

    <?php else: ?>
        <div class="tg-card tg-card-unlinked">
            <div class="tg-status-row">
                <div style="font-size: 2.2em; line-height: 1;">📱</div>
                <div style="flex: 1; min-width: 200px;">
                    <div style="font-size: 1.15em; font-weight: 600;">
                        Aún no has vinculado tu Telegram
                    </div>
                    <div style="opacity: 0.7; font-size: 0.92em; margin-top: 2px;">
                        Toma menos de 30 segundos.
