<?php
/**
 * Staff-facing Telegram management page.
 *
 * Drop at <osticket>/scp/link-telegram.php
 *
 * Five tabs:
 *   1. 🔗 Mi vinculación         — all staff. Personal link status + actions.
 *   2. 🔔 Notificaciones         — admin only. Master switches + admin chat IDs + per-event matrix.
 *   3. 👤 Vinculación clientes   — admin only. Deep-link, manual chat_id, opt-in, token TTL.
 *   4. 📝 Plantillas             — admin only. Parse mode + base URL + 8 message templates.
 *   5. 🎨 Formato                — admin only. URL previews, silent send, inline buttons, pacing.
 *
 * Settings save into the same `ostt4_config` namespace as the plugin
 * admin page, so they take effect immediately and stay in sync.
 *
 * NOTE: never use `$cfg` as a local — staff.inc.php sets it as the global
 * OsticketConfig.
 *
 * @license GPL-2.0-or-later
 */

require_once 'staff.inc.php';

if (!$thisstaff || !$thisstaff->getId() || !$thisstaff->isValid()) {
    Http::redirect('login.php');
    exit;
}

// Locate the plugin + active instance.
$plugin = null;
$activeInstance = null;
try {
    $pm = new PluginManager();
    foreach ($pm->allInstalled() as $p) {
        if (method_exists($p, 'getName')
                && stripos($p->getName(), 'Telegram Bot Notifications') !== false) {
            $plugin = $p;
            if (method_exists($p, 'getActiveInstances')) {
                foreach ($p->getActiveInstances() as $inst) {
                    $activeInstance = $inst;
                    $p->getConfig($inst);
                    break;
                }
            }
            break;
        }
    }
} catch (Exception $e) {
    error_log('[TelegramBot/link-staff] plugin lookup failed: ' . $e->getMessage());
}

if (!$plugin || !$activeInstance) {
    require_once STAFFINC_DIR . 'header.inc.php';
    echo '<div class="error" style="padding:20px;">Telegram plugin not available right now.</div>';
    require_once STAFFINC_DIR . 'footer.inc.php';
    exit;
}

$staffId  = (int) $thisstaff->getId();
$isAdmin  = method_exists($thisstaff, 'isAdmin') && $thisstaff->isAdmin();
$instanceId = (int) $activeInstance->getId();
$pluginId   = (int) $plugin->getId();
$namespace  = 'plugin.' . $pluginId . '.instance.' . $instanceId;

$validTabs = array('link');
if ($isAdmin) {
    $validTabs = array('link', 'notif', 'linking', 'templates', 'format');
}
// NOTE: do NOT name this `$tab` — osTicket's navigation.tmpl.php iterates
// `foreach ($tabs as $name => $tab)` inside header.inc.php, which clobbers
// any `$tab` in the calling scope. We read GET['tab'] but store as
// `$activeTab` so post-header references survive.
$activeTab = isset($_GET['tab']) ? (string) $_GET['tab'] : 'link';
if (!in_array($activeTab, $validTabs, true)) {
    $activeTab = 'link';
}

/**
 * Upsert a batch of config rows in the plugin's instance namespace.
 * Skips silently if value is null (caller can use null to "not change").
 */
function tg_save_keys($namespace, array $keys) {
    $nsEsc = db_real_escape((string) $namespace, false);
    foreach ($keys as $k => $v) {
        if ($v === null) { continue; }
        $kEsc = db_real_escape((string) $k, false);
        $vEsc = db_real_escape((string) $v, false);
        db_query("INSERT INTO " . CONFIG_TABLE
            . " (namespace, `key`, value) VALUES (\"" . $nsEsc . "\", \"" . $kEsc . "\", \"" . $vEsc . "\")"
            . " ON DUPLICATE KEY UPDATE value=\"" . $vEsc . "\"");
    }
}

/** Read a row's current value, or return $default if missing. */
function tg_read($namespace, $key, $default = '') {
    $nsEsc = db_real_escape((string) $namespace, false);
    $kEsc  = db_real_escape((string) $key, false);
    $res = db_query("SELECT value FROM " . CONFIG_TABLE
        . " WHERE namespace=\"" . $nsEsc . "\" AND `key`=\"" . $kEsc . "\" LIMIT 1");
    if ($res && ($row = db_fetch_array($res))) {
        return (string) $row['value'];
    }
    return $default;
}

// ─── POST handlers ───────────────────────────────────────────────────

$okMsg = '';
$errorMsg = '';
$action = isset($_POST['action']) ? (string) $_POST['action'] : '';

if ($action === 'link' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $url = $plugin->generateStaffLinkUrl($staffId);
    } catch (Exception $e) {
        $url = null;
    }
    if ($url && preg_match('#^https://t\.me/#', $url)) {
        Http::redirect($url);
        exit;
    }
    $errorMsg = 'No se pudo generar la URL de vinculación. Intenta de nuevo.';
}

if ($action === 'unlink' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $rm = new ReflectionMethod($plugin, 'links');
        $rm->setAccessible(true);
        $store = $rm->invoke($plugin);
        $store->unlinkStaffById($staffId);
        $okMsg = 'Telegram desvinculado. Ya no recibirás notificaciones aquí.';
    } catch (Exception $e) {
        $errorMsg = 'No se pudo desvincular. Intenta de nuevo.';
    }
}

if ($action === 'save_notif' && $isAdmin && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $events = array(
        'evt_ticket_created__client', 'evt_ticket_created__admin',
        'evt_user_reply__admin',
        'evt_staff_reply__client', 'evt_staff_reply__admin',
        'evt_status_changed__client', 'evt_status_changed__admin',
        'evt_assignment_changed__admin',
    );
    $payload = array(
        'notify_clients' => isset($_POST['notify_clients']) ? '1' : '0',
        'notify_admins'  => isset($_POST['notify_admins'])  ? '1' : '0',
    );
    // Validate + clean admin chat IDs (signed integer per line).
    $raw = isset($_POST['admin_chat_ids']) ? (string) $_POST['admin_chat_ids'] : '';
    $clean = array();
    foreach (preg_split('/\r?\n/', $raw) as $line) {
        $line = trim($line);
        if ($line === '') { continue; }
        if (preg_match('/^-?\d{4,20}$/', $line)) {
            $clean[] = $line;
        }
    }
    $payload['admin_chat_ids'] = implode("\n", $clean);
    foreach ($events as $k) {
        $payload[$k] = !empty($_POST[$k]) ? '1' : '0';
    }
    tg_save_keys($namespace, $payload);
    $okMsg = 'Preferencias de notificación guardadas.';
}

if ($action === 'save_templates' && $isAdmin && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $templates = array(
        'tpl_client_created', 'tpl_client_staff_reply', 'tpl_client_status',
        'tpl_admin_created', 'tpl_admin_user_reply', 'tpl_admin_staff_reply',
        'tpl_admin_status', 'tpl_admin_assignment',
    );
    $payload = array();
    $pm = isset($_POST['parse_mode']) ? (string) $_POST['parse_mode'] : 'HTML';
    if (!in_array($pm, array('HTML', 'MarkdownV2', ''), true)) {
        $pm = 'HTML';
    }
    $payload['parse_mode'] = $pm;
    $base = trim((string) (isset($_POST['base_url']) ? $_POST['base_url'] : ''));
    if ($base !== '' && !preg_match('#^https?://#i', $base)) {
        $errorMsg = 'La URL base debe empezar con http:// o https://.';
    } else {
        $payload['base_url'] = rtrim($base, '/');
        foreach ($templates as $k) {
            $payload[$k] = isset($_POST[$k]) ? (string) $_POST[$k] : '';
        }
        tg_save_keys($namespace, $payload);
        $okMsg = 'Plantillas guardadas.';
    }
}

if ($action === 'save_linking' && $isAdmin && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $ttl = (int) preg_replace('/\D+/', '', (string) (isset($_POST['link_token_ttl']) ? $_POST['link_token_ttl'] : '900'));
    if ($ttl < 60)    { $ttl = 60; }
    if ($ttl > 86400) { $ttl = 86400; }
    $payload = array(
        'send_link_offer_email' => !empty($_POST['send_link_offer_email']) ? '1' : '0',
        'link_token_ttl'        => (string) $ttl,
    );
    tg_save_keys($namespace, $payload);
    $okMsg = 'Preferencias de vinculación guardadas.';
}

if ($action === 'save_format' && $isAdmin && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $payload = array(
        'disable_web_page_preview' => !empty($_POST['disable_web_page_preview']) ? '1' : '0',
        'disable_notification'     => !empty($_POST['disable_notification']) ? '1' : '0',
        'btn_view_ticket'          => !empty($_POST['btn_view_ticket']) ? '1' : '0',
        'btn_view_ticket_label'    => isset($_POST['btn_view_ticket_label']) ? (string) $_POST['btn_view_ticket_label'] : '',
        'btn_reply'                => !empty($_POST['btn_reply']) ? '1' : '0',
        'btn_reply_label'          => isset($_POST['btn_reply_label']) ? (string) $_POST['btn_reply_label'] : '',
        'send_delay_ms'            => preg_replace('/\D+/', '', (string) (isset($_POST['send_delay_ms']) ? $_POST['send_delay_ms'] : '0')),
    );
    if ($payload['send_delay_ms'] === '') { $payload['send_delay_ms'] = '0'; }
    tg_save_keys($namespace, $payload);
    $okMsg = 'Formato y botones guardados.';
}

// ─── Read current link status (for tab 1) ────────────────────────────
$linkedChatId = null;
$linkedAt = null;
try {
    $rm = new ReflectionMethod($plugin, 'links');
    $rm->setAccessible(true);
    $store = $rm->invoke($plugin);
    $linkedChatId = $store->chatIdForStaff($staffId);
    if ($linkedChatId !== null) {
        $res = db_query('SELECT linked_at FROM ' . TABLE_PREFIX . 'telegram_staff_links WHERE staff_id=' . $staffId);
        if ($res && ($row = db_fetch_array($res))) {
            $linkedAt = (int) $row['linked_at'];
        }
    }
} catch (Exception $e) {}

// NEVER reassign $cfg — it's the OsticketConfig global.
$pluginCfg = $plugin->getConfig();

if ($nav) {
    $nav->setTabActive('dashboard');
}
require_once STAFFINC_DIR . 'header.inc.php';

$maskChat = function ($id) {
    $s = (string) $id;
    $len = strlen($s);
    if ($len <= 6) { return str_repeat('•', $len); }
    return substr($s, 0, 2) . str_repeat('•', $len - 6) . substr($s, -4);
};

$botUsername = (string) $pluginCfg->get('bot_username');
?>

<style>
