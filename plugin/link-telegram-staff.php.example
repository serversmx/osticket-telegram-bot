.tg-info-list li { padding: 6px 0; opacity: 0.85; display: flex; align-items: start; gap: 10px; }
.tg-info-list li:before { content: "✓"; color: #16a34a; font-weight: 700; flex-shrink: 0; }
.tg-flash { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: 0.95em; }
.tg-flash-ok { background: rgba(22, 163, 74, 0.15); color: #16a34a; border: 1px solid rgba(22, 163, 74, 0.3); }
.tg-flash-err { background: rgba(220, 38, 38, 0.12); color: #dc2626; border: 1px solid rgba(220, 38, 38, 0.3); }
.tg-divider { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(127, 127, 127, 0.2); opacity: 0.7; font-size: 0.88em; }
.tg-form-grid { display: grid; grid-template-columns: 220px 1fr; gap: 14px 20px; align-items: start; }
.tg-form-grid label { padding-top: 8px; opacity: 0.85; font-weight: 500; }
.tg-form-grid .tg-help { grid-column: 2 / 3; opacity: 0.65; font-size: 0.85em; margin-top: -8px; }
.tg-form-grid input[type="text"], .tg-form-grid input[type="number"], .tg-form-grid textarea, .tg-form-grid select {
    width: 100%; padding: 8px 10px;
    border: 1px solid rgba(127, 127, 127, 0.3);
    background: rgba(127, 127, 127, 0.04);
    color: inherit;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.95em;
}
.tg-form-grid textarea { min-height: 90px; resize: vertical; }
.tg-form-grid input[type="checkbox"] { margin-right: 6px; }
.tg-section-label { font-weight: 600; padding: 16px 0 8px; opacity: 0.85; border-top: 1px solid rgba(127, 127, 127, 0.2); margin-top: 16px; }
.tg-section-label:first-of-type { border-top: 0; margin-top: 0; padding-top: 0; }
.tg-events-matrix { display: grid; grid-template-columns: 1fr 140px 140px; gap: 8px 16px; align-items: center; padding: 10px 0; }
.tg-events-matrix-header { font-weight: 600; opacity: 0.7; font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.04em; padding-bottom: 6px; border-bottom: 1px solid rgba(127, 127, 127, 0.2); }
.tg-save-bar { margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(127, 127, 127, 0.2); display: flex; gap: 10px; }
@media (max-width: 720px) {
    .tg-steps { grid-template-columns: 1fr; }
    .tg-form-grid { grid-template-columns: 1fr; gap: 4px 0; }
    .tg-form-grid label { padding-top: 12px; }
    .tg-form-grid .tg-help { grid-column: 1; }
    .tg-events-matrix { grid-template-columns: 1fr 80px 80px; }
}
</style>

<div class="tg-page">
    <h2 class="tg-title">📲 Telegram</h2>
    <p class="tg-subtitle">Notificaciones de tickets por Telegram. Vincula tu chat, configura eventos, plantillas y formato.</p>

    <ul class="tg-tabs">
        <li class="<?php echo $activeTab === 'link' ? 'active' : ''; ?>"><a href="?tab=link">🔗 Mi vinculación</a></li>
        <?php if ($isAdmin): ?>
            <li class="<?php echo $activeTab === 'notif' ? 'active' : ''; ?>"><a href="?tab=notif">🔔 Notificaciones</a></li>
            <li class="<?php echo $activeTab === 'linking' ? 'active' : ''; ?>"><a href="?tab=linking">👤 Vinculación clientes</a></li>
            <li class="<?php echo $activeTab === 'templates' ? 'active' : ''; ?>"><a href="?tab=templates">📝 Plantillas</a></li>
            <li class="<?php echo $activeTab === 'format' ? 'active' : ''; ?>"><a href="?tab=format">🎨 Formato</a></li>
        <?php endif; ?>
    </ul>

    <?php if (!empty($okMsg)): ?>
        <div class="tg-flash tg-flash-ok"><?php echo Format::htmlchars($okMsg); ?></div>
    <?php endif; ?>
    <?php if (!empty($errorMsg)): ?>
        <div class="tg-flash tg-flash-err"><?php echo Format::htmlchars($errorMsg); ?></div>
    <?php endif; ?>

    <?php // ═════════════════ TAB 1: Mi vinculación ═════════════════ ?>
    <?php if ($activeTab === 'link'): ?>
        <?php if ($linkedChatId): ?>
            <div class="tg-card tg-card-linked">
                <div class="tg-status-row">
                    <div style="font-size: 2.2em; line-height: 1;">✅</div>
                    <div style="flex: 1; min-width: 200px;">
                        <div style="font-size: 1.15em; font-weight: 600;">Cuenta vinculada</div>
                        <div style="opacity: 0.7; font-size: 0.92em; margin-top: 2px;">Estás recibiendo notificaciones admin en este chat.</div>
                    </div>
                    <span class="tg-status-badge tg-status-linked">● ACTIVO</span>
                </div>
                <div class="tg-meta-row">
                    <div class="tg-meta-item">
                        <span class="tg-meta-label">Chat ID</span>
                        <span class="tg-meta-value"><?php echo Format::htmlchars($maskChat($linkedChatId)); ?></span>
                    </div>
                    <div class="tg-meta-item">
                        <span class="tg-meta-label">Bot</span>
                        <span class="tg-meta-value">
                            <?php if ($botUsername): ?>
                                <a href="https://t.me/<?php echo rawurlencode($botUsername); ?>" target="_blank" rel="noopener">@<?php echo Format::htmlchars($botUsername); ?></a>
                            <?php else: ?>
                                <em style="opacity: 0.6;">no configurado</em>
                            <?php endif; ?>
                        </span>
                    </div>
                    <?php if ($linkedAt): ?>
                        <div class="tg-meta-item">
                            <span class="tg-meta-label">Vinculado desde</span>
                            <span class="tg-meta-value"><?php echo Format::htmlchars(date('Y-m-d H:i', $linkedAt)); ?></span>
                        </div>
                    <?php endif; ?>
                </div>
                <div class="tg-actions">
                    <?php if ($botUsername): ?>
                        <a href="https://t.me/<?php echo rawurlencode($botUsername); ?>" target="_blank" rel="noopener" class="tg-btn tg-btn-primary">💬 Abrir chat con el bot</a>
                    <?php endif; ?>
                    <form method="POST" style="display: inline;" onsubmit="return confirm('¿Seguro que quieres desvincular? Dejarás de recibir notificaciones aquí.');">
                        <?php csrf_token(); ?>
                        <input type="hidden" name="action" value="unlink">
                        <button class="tg-btn tg-btn-danger" type="submit">🔌 Desvincular</button>
                    </form>
                </div>
            </div>
            <div class="tg-card">
                <div style="font-weight: 600; margin-bottom: 12px;">Qué recibes en tu Telegram</div>
                <ul class="tg-info-list">
                    <li>Nuevos tickets creados por clientes</li>
                    <li>Respuestas de clientes en tickets existentes</li>
                    <li>Cambios de estado del ticket (si están activados en la config)</li>
                    <li>Reasignaciones de ticket (si están activadas en la config)</li>
                </ul>
            </div>
        <?php else: ?>
            <div class="tg-card tg-card-unlinked">
                <div class="tg-status-row">
                    <div style="font-size: 2.2em; line-height: 1;">📱</div>
                    <div style="flex: 1; min-width: 200px;">
                        <div style="font-size: 1.15em; font-weight: 600;">Aún no has vinculado tu Telegram</div>
                        <div style="opacity: 0.7; font-size: 0.92em; margin-top: 2px;">Toma menos de 30 segundos.</div>
                    </div>
                    <span class="tg-status-badge tg-status-unlinked">● PENDIENTE</span>
                </div>
                <div class="tg-steps">
                    <div class="tg-step">
                        <span class="tg-step-num">1</span>
                        <div class="tg-step-icon">👇</div>
                        <div class="tg-step-text">Presiona <strong>Vincular mi Telegram</strong>.</div>
                    </div>
                    <div class="tg-step">
                        <span class="tg-step-num">2</span>
                        <div class="tg-step-icon">💬</div>
                        <div class="tg-step-text">Se abre Telegram con un comando precargado. Presiona <strong>Start</strong>.</div>
                    </div>
                    <div class="tg-step">
                        <span class="tg-step-num">3</span>
                        <div class="tg-step-icon">✅</div>
                        <div class="tg-step-text">El bot confirma. Listo — recibirás avisos en tu chat.</div>
                    </div>
                </div>
                <div class="tg-actions" style="margin-top: 22px;">
                    <form method="POST" style="display: inline;">
                        <?php csrf_token(); ?>
                        <input type="hidden" name="action" value="link">
                        <button class="tg-btn tg-btn-primary tg-btn-large" type="submit">🔗 Vincular mi Telegram</button>
                    </form>
                </div>
                <div class="tg-divider"><strong>¿Privacidad?</strong> El bot solo te envía mensajes; no lee tus chats. Si decides desvincular después, simplemente vuelve aquí.</div>
            </div>
        <?php endif; ?>
    <?php endif; ?>

    <?php // ═════════════════ TAB 2: Notificaciones (admin) ═════════════════ ?>
    <?php if ($activeTab === 'notif' && $isAdmin):
        $g = function ($k, $d = '') use ($namespace) {
            $v = tg_read($namespace, $k, '__NONE__');
            if ($v !== '__NONE__') { return $v; }
            $defs = TelegramBotNotificationsPlugin::prefDefaults();
            return array_key_exists($k, $defs) ? $defs[$k] : $d;
        };
        $on = function ($k, $d = '0') use ($g) { return $g($k, $d) === '1'; };
        $events = array(
            'evt_ticket_created'   => array('Ticket creado',          true,  true),
            'evt_user_reply'       => array('Respuesta del cliente',  null,  true),  // no client side
            'evt_staff_reply'      => array('Respuesta del staff',    true,  true),
            'evt_status_changed'   => array('Cambio de estado',       true,  true),
            'evt_assignment_changed' => array('Cambio de asignación', null,  true),  // no client side
        );
    ?>
        <form method="POST" class="tg-card">
            <?php csrf_token(); ?>
            <input type="hidden" name="action" value="save_notif">

            <div class="tg-section-label">Interruptores maestros</div>
            <div class="tg-form-grid">
                <label for="notify_clients">Notificar a clientes</label>
                <div>
                    <input type="checkbox" id="notify_clients" name="notify_clients" value="1" <?php echo $on('notify_clients') ? 'checked' : ''; ?>>
                    <span style="opacity:0.75;">Master switch para TODAS las notificaciones a clientes.</span>
                </div>
                <label for="notify_admins">Notificar a admins</label>
                <div>
                    <input type="checkbox" id="notify_admins" name="notify_admins" value="1" <?php echo $on('notify_admins') ? 'checked' : ''; ?>>
                    <span style="opacity:0.75;">Master switch para TODAS las notificaciones a admins.</span>
                </div>
                <label for="admin_chat_ids">Chats admin (manuales)</label>
                <div>
                    <textarea id="admin_chat_ids" name="admin_chat_ids" rows="3" placeholder="Un chat_id por línea. Ejemplo: -1001234567890"><?php echo Format::htmlchars($g('admin_chat_ids')); ?></textarea>
                </div>
                <div></div>
                <div class="tg-help">Chats admin estáticos (grupo de soporte, etc.). Los staff vinculados via "Mi vinculación" se agregan automáticamente.</div>
            </div>

            <div class="tg-section-label">Matriz de eventos</div>
            <div class="tg-events-matrix">
                <div></div>
                <div class="tg-events-matrix-header">→ Cliente</div>
                <div class="tg-events-matrix-header">→ Admin</div>
                <?php foreach ($events as $key => $row):
                    list($label, $clientOn, $adminOn) = $row;
                    $kClient = $key . '__client';
                    $kAdmin  = $key . '__admin';
                ?>
                    <div><?php echo Format::htmlchars($label); ?></div>
                    <div>
                        <?php if ($clientOn !== null): ?>
                            <input type="checkbox" name="<?php echo $kClient; ?>" value="1" <?php echo $on($kClient) ? 'checked' : ''; ?>>
                        <?php else: ?>
                            <span style="opacity:0.4;">—</span>
                        <?php endif; ?>
                    </div>
                    <div>
                        <?php if ($adminOn !== null): ?>
                            <input type="checkbox" name="<?php echo $kAdmin; ?>" value="1" <?php echo $on($kAdmin) ? 'checked' : ''; ?>>
                        <?php else: ?>
                            <span style="opacity:0.4;">—</span>
                        <?php endif; ?>
                    </div>
                <?php endforeach; ?>
            </div>

            <div class="tg-save-bar">
                <button type="submit" class="tg-btn tg-btn-primary">💾 Guardar notificaciones</button>
            </div>
        </form>
    <?php endif; ?>

    <?php // ═════════════════ TAB 3: Vinculación clientes (admin) ═════════════════ ?>
    <?php if ($activeTab === 'linking' && $isAdmin):
        $g = function ($k, $d = '') use ($namespace) {
            $v = tg_read($namespace, $k, '__NONE__');
            if ($v !== '__NONE__') { return $v; }
            $defs = TelegramBotNotificationsPlugin::prefDefaults();
            return array_key_exists($k, $defs) ? $defs[$k] : $d;
        };
        $on = function ($k, $d = '0') use ($g) { return $g($k, $d) === '1'; };
    ?>
        <form method="POST" class="tg-card">
            <?php csrf_token(); ?>
            <input type="hidden" name="action" value="save_linking">

            <div style="padding:14px 18px;background:rgba(37,99,235,0.08);border-left:4px solid #2563eb;border-radius:6px;margin:0 0 18px;font-size:0.95em;">
                <strong>🆕 Flujo unificado de vinculación.</strong> Desde v0.2 el plugin
                <em>solo</em> usa deep-link de Telegram. Se eliminaron los campos
                <code>telegram_chat_id</code> y <code>telegram_opt_in</code> del
                formulario de contacto. El cliente vincula su Telegram con un clic
                desde el correo automático que recibe al crear su ticket o desde
                <code>/link-telegram.php</code>. Para des-suscribirse, envía
                <code>/unlink</code> al bot.
            </div>

            <div class="tg-section-label">Correo de invitación al crear ticket</div>
            <div class="tg-form-grid">
                <label for="send_link_offer_email">Enviar invitación por correo</label>
                <div>
                    <input type="checkbox" id="send_link_offer_email" name="send_link_offer_email" value="1" <?php echo $on('send_link_offer_email', '1') ? 'checked' : ''; ?>>
                    <span style="opacity:0.75;">Después de crear un ticket, si el cliente todavía no tiene Telegram vinculado, le mandamos un correo con un botón <em>Vincular mi Telegram</em>. Funciona tanto para clientes logueados como para visitantes (osTicket crea siempre un User al recibir el ticket).</span>
                </div>
            </div>

            <div class="tg-section-label">Tokens de vinculación</div>
            <div class="tg-form-grid">
                <label for="link_token_ttl">TTL del token (segundos)</label>
                <div>
                    <input type="number" id="link_token_ttl" name="link_token_ttl" value="<?php echo Format::htmlchars($g('link_token_ttl', '900')); ?>" min="60" max="86400" style="max-width:200px;">
                    <div class="tg-help" style="opacity:0.7;font-size:0.85em;margin-top:4px;">Cuánto tiempo dura un token <code>/start</code> antes de expirar. Default 900 = 15 min.</div>
                </div>
            </div>

            <div class="tg-save-bar">
                <button type="submit" class="tg-btn tg-btn-primary">💾 Guardar vinculación</button>
            </div>
        </form>
    <?php endif; ?>

    <?php // ═════════════════ TAB 4: Plantillas (admin) ═════════════════ ?>
    <?php if ($activeTab === 'templates' && $isAdmin):
        $g = function ($k, $d = '') use ($namespace) {
            $v = tg_read($namespace, $k, '__NONE__');
            if ($v !== '__NONE__') { return $v; }
            $defs = TelegramBotNotificationsPlugin::prefDefaults();
            return array_key_exists($k, $defs) ? $defs[$k] : $d;
        };
        $templates = array(
            'tpl_client_created'     => 'Cliente — ticket creado',
            'tpl_client_staff_reply' => 'Cliente — respuesta del staff',
            'tpl_client_status'      => 'Cliente — cambio de estado',
            'tpl_admin_created'      => 'Admin — ticket creado',
            'tpl_admin_user_reply'   => 'Admin — respuesta del cliente',
            'tpl_admin_staff_reply'  => 'Admin — respuesta del staff',
            'tpl_admin_status'       => 'Admin — cambio de estado',
            'tpl_admin_assignment'   => 'Admin — cambio de asignación',
        );
        $currentParseMode = $g('parse_mode', 'HTML');
    ?>
        <form method="POST" class="tg-card">
            <?php csrf_token(); ?>
            <input type="hidden" name="action" value="save_templates">

            <div class="tg-section-label">Formato y enlaces</div>
            <div class="tg-form-grid">
                <label for="parse_mode">Parse mode</label>
                <div>
                    <select id="parse_mode" name="parse_mode">
                        <option value="HTML" <?php echo $currentParseMode === 'HTML' ? 'selected' : ''; ?>>HTML (recomendado)</option>
                        <option value="MarkdownV2" <?php echo $currentParseMode === 'MarkdownV2' ? 'selected' : ''; ?>>MarkdownV2 (avanzado)</option>
                        <option value="" <?php echo $currentParseMode === '' ? 'selected' : ''; ?>>Texto plano</option>
                    </select>
                </div>
                <div></div>
                <div class="tg-help">HTML: <code>&lt;b&gt;negrita&lt;/b&gt; &lt;i&gt;cursiva&lt;/i&gt; &lt;a href="url"&gt;link&lt;/a&gt;</code>. Variables se auto-escapan.</div>

                <label for="base_url">osTicket base URL</label>
                <div><input type="text" id="base_url" name="base_url" value="<?php echo Format::htmlchars($g('base_url')); ?>" placeholder="https://tickets.example.com"></div>
                <div></div>
                <div class="tg-help">Requerida para que <code>{{ticket_link}}</code> y los botones inline funcionen. Sin slash final.</div>
            </div>

            <div class="tg-section-label">Plantillas</div>
            <div class="tg-help" style="margin-bottom: 12px;">
                Placeholders: <code>{{ticket_number}} {{subject}} {{name}} {{email}} {{department}} {{priority}} {{status}} {{assignee}} {{poster_type}} {{message}} {{ticket_link}}</code>
            </div>
            <div class="tg-form-grid">
                <?php foreach ($templates as $key => $label): ?>
                    <label for="<?php echo $key; ?>"><?php echo Format::htmlchars($label); ?></label>
                    <div><textarea id="<?php echo $key; ?>" name="<?php echo $key; ?>" rows="4"><?php echo Format::htmlchars($g($key)); ?></textarea></div>
                <?php endforeach; ?>
            </div>

            <div class="tg-save-bar">
                <button type="submit" class="tg-btn tg-btn-primary">💾 Guardar plantillas</button>
            </div>
        </form>
    <?php endif; ?>

    <?php // ═════════════════ TAB 5: Formato (admin) ═════════════════ ?>
    <?php if ($activeTab === 'format' && $isAdmin):
        $g = function ($k, $d = '') use ($namespace) {
            $v = tg_read($namespace, $k, '__NONE__');
            if ($v !== '__NONE__') { return $v; }
            $defs = TelegramBotNotificationsPlugin::prefDefaults();
            return array_key_exists($k, $defs) ? $defs[$k] : $d;
        };
        $on = function ($k) use ($g) { return $g($k) === '1'; };
    ?>
        <form method="POST" class="tg-card">
            <?php csrf_token(); ?>
            <input type="hidden" name="action" value="save_format">

            <div class="tg-section-label">Opciones de mensaje</div>
            <div class="tg-form-grid">
                <label for="disable_web_page_preview">Sin preview de URLs</label>
                <div>
                    <input type="checkbox" id="disable_web_page_preview" name="disable_web_page_preview" value="1" <?php echo $on('disable_web_page_preview') ? 'checked' : ''; ?>>
                    <span style="opacity:0.75;">Suprime las tarjetas de vista previa que Telegram muestra para URLs en los mensajes.</span>
                </div>
                <label for="disable_notification">Envío silencioso</label>
