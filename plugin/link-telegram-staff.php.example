<?php
/**
 * Staff-facing entry point for Telegram account linking.
 *
 * Drop this file in osTicket's `scp/` directory (so it benefits from the
 * staff-scoped routing rules):
 *
 *   cp plugin/link-telegram-staff.php.example /path/to/osticket/scp/link-telegram.php
 *
 * Flow:
 *   1. Staff member (logged in to the SCP) hits
 *      https://<your-osticket>/scp/link-telegram.php
 *   2. staff.inc.php bootstraps osTicket and enforces staff auth.
 *   3. The plugin mints a one-shot, 15-min-TTL token bound to the
 *      Staff record, builds the t.me deep link.
 *   4. Browser redirects to https://t.me/<bot>?start=<token>.
 *   5. Staff presses Start in Telegram → bot's webhook receives /start
 *      <token> → plugin's handleStart() routes to consumeStaffToken() →
 *      linkStaff() persists (staff_id, chat_id) in
 *      <prefix>telegram_staff_links.
 *   6. From then on, the plugin's sendToAdmins() includes this chat_id
 *      in the recipient list (merged with the manual admin_chat_ids
 *      config — duplicates deduped).
 *
 * The staff member never sees the chat_id. One click + Press Start.
 *
 * @license GPL-2.0-or-later
 */

require_once 'staff.inc.php';

if (!$thisstaff || !$thisstaff->getId() || !$thisstaff->isValid()) {
    // staff.inc.php normally handles this, but be defensive.
    Http::redirect('login.php');
    exit;
}

$plugin = null;
$instance = null;
try {
    $pm = new PluginManager();
    foreach ($pm->allInstalled() as $p) {
        if (method_exists($p, 'getName')
                && stripos($p->getName(), 'Telegram Bot Notifications') !== false) {
            $plugin = $p;
            if (method_exists($p, 'getActiveInstances')) {
                foreach ($p->getActiveInstances() as $inst) {
                    $instance = $inst;
                    $p->getConfig($inst); // side-load instance config
                    break;
                }
            }
            break;
        }
    }
} catch (Exception $e) {
    error_log('[TelegramBot/link-staff] plugin lookup failed: ' . $e->getMessage());
}

if (!$plugin || !$instance) {
    http_response_code(503);
    echo 'Telegram linking is not available right now.';
    exit;
}

try {
    $url = $plugin->generateStaffLinkUrl($thisstaff->getId());
} catch (Exception $e) {
    error_log('[TelegramBot/link-staff] generateStaffLinkUrl failed: ' . $e->getMessage());
    $url = null;
}

if (!$url || !preg_match('#^https://t\.me/#', $url)) {
    http_response_code(500);
    echo 'Could not generate the Telegram linking URL. Please try again later.';
    exit;
}

Http::redirect($url);
