<?php
/**
 * Landing page for osTicket's staff "Applications" tab.
 *
 * osTicket sets the Applications tab's default href to `apps.php` (see
 * include/class.nav.php). Clicking the tab text directly (instead of
 * hovering for the submenu) navigates here. osTicket does NOT ship this
 * file by default — without it, clicks land on a 404.
 *
 * Drop this file at <osticket>/scp/apps.php to convert the 404 into a
 * useful index of every plugin-registered staff app:
 *
 *   cp plugin/scp-apps-landing.php.example /path/to/osticket/scp/apps.php
 *
 * Not Telegram-specific — iterates whatever any installed plugin has
 * registered via `Application::registerStaffApp()`.
 *
 * NOTE: never use `$cfg` as a local — staff.inc.php sets it as the global
 * OsticketConfig and header.inc.php needs it intact.
 *
 * @license GPL-2.0-or-later
 */

require_once 'staff.inc.php';

if (!class_exists('Application')) {
    require_once INCLUDE_DIR . 'class.app.php';
}

$apps = Application::getStaffApps();

if ($nav) {
    $nav->setTabActive('apps');
}

require_once STAFFINC_DIR . 'header.inc.php';

// Best-effort guess at an icon emoji from the app's iconclass / desc.
// Keeps the layout consistent when plugins don't set an explicit icon.
$pickIcon = function ($app) {
    $hint = strtolower(($app['iconclass'] ?? '') . ' ' . ($app['desc'] ?? ''));
    if (stripos($hint, 'telegram') !== false) { return '💬'; }
    if (stripos($hint, 'whatsapp') !== false || stripos($hint, 'evolution') !== false) { return '📱'; }
    if (stripos($hint, 'mail') !== false || stripos($hint, 'email') !== false) { return '✉️'; }
    if (stripos($hint, 'sms') !== false) { return '📨'; }
    if (stripos($hint, 'chart') !== false || stripos($hint, 'report') !== false) { return '📊'; }
    if (stripos($hint, 'comment') !== false) { return '💬'; }
    if (stripos($hint, 'cog') !== false || stripos($hint, 'settings') !== false) { return '⚙️'; }
    return '🔧';
};
?>

<style>
.apps-page { max-width: 980px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.apps-page h2 { font-size: 1.6em; margin: 0 0 6px; color: #0f172a; font-weight: 600; display: flex; align-items: center; gap: 10px; }
.apps-subtitle { color: #64748b; margin: 0 0 28px; font-size: 0.98em; }
.apps-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
.app-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; text-decoration: none; color: inherit; transition: all 0.15s ease; display: flex; flex-direction: column; gap: 12px; position: relative; overflow: hidden; }
.app-card:before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: #2563eb; transform: scaleY(0); transform-origin: top; transition: transform 0.2s; }
.app-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08); border-color: #cbd5e1; color: inherit; text-decoration: none; }
.app-card:hover:before { transform: scaleY(1); }
.app-card-header { display: flex; align-items: center; gap: 14px; }
.app-card-icon { width: 48px; height: 48px; background: linear-gradient(135deg, #eff6ff, #dbeafe); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.6em; flex-shrink: 0; }
.app-card-title { font-size: 1.1em; font-weight: 600; color: #0f172a; line-height: 1.3; }
.app-card-desc { color: #64748b; font-size: 0.92em; line-height: 1.5; flex: 1; }
.app-card-cta { display: inline-flex; align-items: center; gap: 6px; color: #2563eb; font-weight: 600; font-size: 0.9em; margin-top: 6px; }
.app-card-cta:after { content: "→"; transition: transform 0.15s; }
.app-card:hover .app-card-cta:after { transform: translateX(4px); }
.apps-empty { background: #fff; border: 2px dashed #e2e8f0; border-radius: 12px; padding: 60px 20px; text-align: center; }
.apps-empty-icon { font-size: 3em; margin-bottom: 12px; opacity: 0.5; }
.apps-empty-title { font-size: 1.15em; font-weight: 600; color: #475569; margin-bottom: 8px; }
.apps-empty-desc { color: #94a3b8; max-width: 460px; margin: 0 auto; font-size: 0.95em; line-height: 1.5; }
.apps-footer { margin-top: 32px; padding-top: 20px; border-top: 1px solid #e2e8f0; color: #94a3b8; font-size: 0.85em; }
.apps-footer code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; color: #475569; }
</style>

<div class="apps-page">
    <h2>⚡ Aplicaciones</h2>
    <p class="apps-subtitle">Funcionalidades aportadas por plugins instalados. Selecciona una para gestionarla.</p>

    <?php if (!$apps): ?>
        <div class="apps-empty">
            <div class="apps-empty-icon">🧩</div>
            <div class="apps-empty-title">No hay aplicaciones registradas</div>
            <div class="apps-empty-desc">
                Las aplicaciones aparecen aquí cuando un plugin instalado las registra mediante
                <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">Application::registerStaffApp()</code>.
                Verifica en <strong>Admin Panel → Manage → Plugins</strong> que tus plugins estén activos.
            </div>
        </div>
    <?php else: ?>
        <div class="apps-grid">
            <?php foreach ($apps as $app):
                $desc  = isset($app['desc']) ? (string) $app['desc'] : 'App';
                $href  = isset($app['href']) ? (string) $app['href'] : '#';
                $title = isset($app['title']) ? (string) $app['title'] : '';
                $icon  = $pickIcon($app);
            ?>
                <a href="<?php echo Format::htmlchars($href); ?>" class="app-card">
                    <div class="app-card-header">
                        <div class="app-card-icon"><?php echo $icon; ?></div>
                        <div>
                            <div class="app-card-title"><?php echo Format::htmlchars($desc); ?></div>
                        </div>
                    </div>
                    <?php if ($title && $title !== $desc): ?>
                        <div class="app-card-desc"><?php echo Format::htmlchars($title); ?></div>
                    <?php endif; ?>
                    <div class="app-card-cta">Abrir</div>
                </a>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <div class="apps-footer">
        Las aplicaciones se registran al bootstrap de cada plugin. Si esperabas ver una y no aparece, revisa que el plugin esté <strong>activo</strong> y refresca esta página.
    </div>
</div>

<?php
require_once STAFFINC_DIR . 'footer.inc.php';
