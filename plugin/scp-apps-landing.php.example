<?php
/**
 * Landing page for osTicket's staff "Applications" tab.
 *
 * osTicket sets the Applications tab's default href to `apps.php` (see
 * include/class.nav.php). Clicking the tab text directly (instead of
 * hovering for the submenu) navigates here. osTicket does NOT ship this
 * file by default — without it, clicks land on a 404.
 *
 * Drop this file at <osticket>/scp/apps.php to convert the 404 into a
 * useful index of every plugin-registered staff app:
 *
 *   cp plugin/scp-apps-landing.php.example /path/to/osticket/scp/apps.php
 *
 * Theme-agnostic CSS: uses semi-transparent backgrounds + `color: inherit`
 * so it adapts to whatever theme (light / dark / branded green / etc.)
 * the staff is using. No hard-coded backgrounds that would clash.
 *
 * NOTE: never use `$cfg` as a local — staff.inc.php sets it as the global
 * OsticketConfig and header.inc.php needs it intact.
 *
 * @license GPL-2.0-or-later
 */

require_once 'staff.inc.php';

if (!class_exists('Application')) {
    require_once INCLUDE_DIR . 'class.app.php';
}

$apps = Application::getStaffApps();

if ($nav) {
    $nav->setTabActive('apps');
}

require_once STAFFINC_DIR . 'header.inc.php';

// Best-effort guess at an icon emoji from the app's iconclass / desc.
$pickIcon = function ($app) {
    $hint = strtolower(($app['iconclass'] ?? '') . ' ' . ($app['desc'] ?? ''));
    if (stripos($hint, 'telegram') !== false) { return '💬'; }
    if (stripos($hint, 'whatsapp') !== false || stripos($hint, 'evolution') !== false) { return '📱'; }
    if (stripos($hint, 'mail') !== false || stripos($hint, 'email') !== false) { return '✉️'; }
    if (stripos($hint, 'sms') !== false) { return '📨'; }
    if (stripos($hint, 'chart') !== false || stripos($hint, 'report') !== false) { return '📊'; }
    if (stripos($hint, 'comment') !== false) { return '💬'; }
    if (stripos($hint, 'cog') !== false || stripos($hint, 'settings') !== false) { return '⚙️'; }
    return '🔧';
};
?>

<style>
/* All selectors prefixed with .apps-page so we never collide with osTicket. */
/* Colors use rgba(0,0,0,...) / rgba(255,255,255,...) and `color: inherit` so */
/* the page adapts to whatever theme (light, dark, branded) is active. */
.apps-page { width: 100%; font-family: inherit; color: inherit; }
.apps-page h2.apps-title { font-size: 1.5em; margin: 0 0 6px; font-weight: 600; display: flex; align-items: center; gap: 10px; color: inherit; }
.apps-page .apps-subtitle { opacity: 0.7; margin: 0 0 24px; font-size: 0.95em; }
.apps-page .apps-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; align-items: stretch; }
.apps-page .app-card {
    background: rgba(127, 127, 127, 0.06);
    border: 1px solid rgba(127, 127, 127, 0.2);
    border-radius: 12px;
    padding: 22px;
    text-decoration: none !important;
    color: inherit !important;
    transition: all 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    overflow: hidden;
}
.apps-page .app-card:before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 4px;
    background: #2563eb; transform: scaleY(0); transform-origin: top;
    transition: transform 0.2s;
}
.apps-page .app-card:hover {
    background: rgba(127, 127, 127, 0.12);
    border-color: rgba(127, 127, 127, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
}
.apps-page .app-card:hover:before { transform: scaleY(1); }
.apps-page .app-card-header { display: flex; align-items: center; gap: 14px; }
.apps-page .app-card-icon {
    width: 48px; height: 48px;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(37, 99, 235, 0.3));
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6em; flex-shrink: 0;
}
.apps-page .app-card-title { font-size: 1.1em; font-weight: 600; line-height: 1.3; color: inherit; }
.apps-page .app-card-desc { opacity: 0.75; font-size: 0.92em; line-height: 1.5; flex: 1; }
.apps-page .app-card-cta {
    display: inline-flex; align-items: center; gap: 6px;
    color: #2563eb; font-weight: 600; font-size: 0.9em; margin-top: 6px;
}
.apps-page .app-card-cta:after { content: "→"; transition: transform 0.15s; }
.apps-page .app-card:hover .app-card-cta:after { transform: translateX(4px); }
.apps-page .apps-empty {
    background: rgba(127, 127, 127, 0.04);
    border: 2px dashed rgba(127, 127, 127, 0.3);
    border-radius: 12px;
    padding: 50px 20px;
    text-align: center;
}
.apps-page .apps-empty-icon { font-size: 2.6em; margin-bottom: 12px; opacity: 0.45; }
.apps-page .apps-empty-title { font-size: 1.1em; font-weight: 600; opacity: 0.75; margin-bottom: 8px; }
.apps-page .apps-empty-desc { opacity: 0.55; max-width: 460px; margin: 0 auto; font-size: 0.95em; line-height: 1.5; }
.apps-page .apps-empty-desc code {
    background: rgba(127, 127, 127, 0.15);
    padding: 2px 6px; border-radius: 4px; font-size: 0.9em;
}
.apps-page .apps-footer {
    margin-top: 28px; padding-top: 18px;
    border-top: 1px solid rgba(127, 127, 127, 0.2);
    opacity: 0.55; font-size: 0.85em;
}
</style>

<div class="apps-page">
    <h2 class="apps-title">⚡ Aplicaciones</h2>
    <p class="apps-subtitle">Funcionalidades aportadas por plugins instalados. Selecciona una para gestionarla.</p>

    <?php if (!$apps): ?>
        <div class="apps-empty">
            <div class="apps-empty-icon">🧩</div>
            <div class="apps-empty-title">No hay aplicaciones registradas</div>
            <div class="apps-empty-desc">
                Las aplicaciones aparecen aquí cuando un plugin instalado las registra mediante
                <code>Application::registerStaffApp()</code>.
                Verifica en <strong>Admin Panel → Manage → Plugins</strong> que tus plugins estén activos.
            </div>
        </div>
    <?php else: ?>
        <div class="apps-grid">
            <?php foreach ($apps as $app):
                $desc  = isset($app['desc']) ? (string) $app['desc'] : 'App';
                $href  = isset($app['href']) ? (string) $app['href'] : '#';
                $title = isset($app['title']) ? (string) $app['title'] : '';
                $icon  = $pickIcon($app);
            ?>
                <a href="<?php echo Format::htmlchars($href); ?>" class="app-card">
                    <div class="app-card-header">
                        <div class="app-card-icon"><?php echo $icon; ?></div>
                        <div>
                            <div class="app-card-title"><?php echo Format::htmlchars($desc); ?></div>
                        </div>
                    </div>
                    <?php if ($title && $title !== $desc): ?>
                        <div class="app-card-desc"><?php echo Format::htmlchars($title); ?></div>
                    <?php endif; ?>
                    <div class="app-card-cta">Abrir</div>
                </a>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

    <div class="apps-footer">
        Las aplicaciones se registran al bootstrap de cada plugin. Si esperabas ver una y no aparece, revisa que el plugin esté <strong>activo</strong> y refresca esta página.
    </div>
</div>

<?php
require_once STAFFINC_DIR . 'footer.inc.php';
